<?xml version="1.0"?>
<ruleset name="Emposo">
	<description>WordPress + WordPress VIP coding standards for the Emposo theme and site plugin.</description>

	<file>themes/emposo</file>
	<file>client-mu-plugins</file>
	<file>plugins</file>
	<file>vip-config</file>
	<file>tests/php</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/reference/*</exclude-pattern>
	<!-- Analysis-only stubs: intentionally not WordPress-formatted. -->
	<exclude-pattern>tests/php/stubs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<!-- Severity 1 mirrors what the hosted VIP Code Analysis Bot reports, so CI
	     output matches what VIP would say if this ever moves onto the platform. -->
	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Built output; Tailwind owns it. -->
		<exclude-pattern>themes/emposo/assets/*</exclude-pattern>
	</rule>
	<rule ref="WordPress-VIP-Go"/>
	<rule ref="WordPressVIPMinimum"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="emposo"/>
				<element value="EMPOSO"/>
				<element value="Emposo"/>
			</property>
		</properties>
	</rule>

	<!-- vip-config/ exists to define WordPress core configuration constants, so
	     the unprefixed-constant rule cannot apply there. WPCS carries a list of
	     known core constants but it is incomplete (FORCE_SSL_ADMIN and
	     SCRIPT_DEBUG pass; DISALLOW_FILE_MODS and WP_AUTO_UPDATE_CORE do not),
	     so the exclusion is scoped to the directory rather than silenced
	     per line, which would need a new ignore every time a constant is added. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>vip-config/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="emposo"/>
			</property>
		</properties>
	</rule>

	<!-- The theme is private and never distributed, so the wordpress.org
	     file-naming convention (class-*.php) is enforced only in the plugin,
	     where the CLI command classes live. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>themes/emposo/*</exclude-pattern>
	</rule>
</ruleset>
