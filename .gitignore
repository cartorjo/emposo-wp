node_modules/
# ANCHORED. Unanchored, `vendor/` matched themes/emposo/assets/vendor/ too, so
# lenis.min.js — enqueued on every page — was never committed: a fresh clone
# 404ed it and smooth scrolling was silently off site-wide, including in CI.
# Only Composer's root vendor directory belongs here.
/vendor/
.DS_Store

# Build + tooling output
.phpcs-cache
# CI writes the checkstyle report here. Never phpcs.xml — phpcs would then
# discover the report as its own configuration.
phpcs-report.xml
.phpunit.result.cache
/tools/.cache/
# WordPress-side reports are regenerated; the static baseline is committed.
/audit-evidence/wp/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
.lighthouseci/

# Local only
.wp-env.override.json
*.log
